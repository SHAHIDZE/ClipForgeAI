# ============================================================

@app.post("/extract-audio/{filename}")
def extract_audio(
    filename: str,
):

    filename = os.path.basename(
        filename
    )

    video_path = os.path.join(
        UPLOAD_FOLDER,
        filename,
    )

    if not os.path.isfile(
        video_path
    ):

        raise HTTPException(
            status_code=404,
            detail="Video topilmadi.",
        )

    audio_name = (
        filename.rsplit(
            ".",
            1,
        )[0]
        + ".mp3"
    )

    audio_path = os.path.join(
        UPLOAD_FOLDER,
        audio_name,
    )

    try:

        (
            ffmpeg
            .input(video_path)
            .output(
                audio_path,
                format="mp3",
                acodec="libmp3lame",
            )
            .run(
                overwrite_output=True
            )
        )

        return {
            "status": "success",
            "audio_file": audio_name,
        }

    except Exception as e:

        return {
            "status": "error",
            "message": str(e),
        }


