@app.get("/exports")
def exports():

    try:

        files = os.listdir(
            EXPORT_FOLDER
        )

    except Exception:

        files = []

    files = [
        file
        for file in files
        if file.endswith(".mp4")
        and file.startswith("short_")
        and not file.endswith(
            "_raw.mp4"
        )
    ]

    files.sort()

    return {
        "count": len(files),
        "files": files,
    }


