# YOUTUBE
# ============================================================

@app.post("/youtube")
def youtube(
    request: YouTubeRequest,
):

    url = request.url.strip()

    if not url:

        raise HTTPException(
            status_code=400,
            detail="Video URL kiritilmadi.",
        )

    try:

        filename = download_youtube(
            url
        )

        return {
            "status": "success",
            "filename": filename,
        }

    except Exception as e:

        print(
            "YOUTUBE DOWNLOAD ERROR:",
            e,
        )

        error_text = str(e)

        if (
            "429" in error_text
            or "bot" in error_text.lower()
            or "sign in" in error_text.lower()
            or "confirm you're not a bot"
            in error_text.lower()
        ):

            raise HTTPException(
                status_code=429,
                detail=(
                    "YouTube hozir bu "
                    "so'rovni blokladi. "
                    "Keyinroq qayta urinib "
                    "ko'ring yoki videoni "
                    "fayl sifatida yuklang."
                ),
            )

        raise HTTPException(
            status_code=500,
            detail=error_text,
        )


